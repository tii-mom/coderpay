// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  emailVerifiedAt DateTime?
  emailVerifyTokenHash String?
  emailVerifyExpiresAt DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  feeBalance   Float           @default(0)
  packageType  String          @default("free") // free, trial, pro, max
  freeOrderUsed Int            @default(0)
  subscriptionStartedAt DateTime?
  subscriptionExpiresAt DateTime?
  firstProDiscountUsed Boolean @default(false)
  firstMaxDiscountUsed Boolean @default(false)
  inviteCode   String?         @unique
  referredByUserId String?
  referredAt   DateTime?
  adminNote    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  apps         App[]
  codes        PaymentCode[]
  devices      Device[]
  exceptions   ExceptionItem[]
  billings     BillingRecord[]
  rechargeOrders RechargeOrder[]
  referralRewards ReferralReward[]
  paymentProviders PaymentProvider[]
}

model App {
  id            String   @id @default(uuid())
  appId         String   @unique
  appSecret     String
  name          String
  notifyUrl     String
  returnUrl     String
  feedbackUrl   String?
  expireMinutes Int      @default(5)
  signType      String   @default("HMAC-SHA256")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]
}

model PaymentCode {
  id           String   @id @default(uuid())
  type         String // wechat / alipay
  codeType     String // fixed / any
  amount       Float // 0.0 for any
  imageUrl     String
  alipayUserId String? // Optional for direct Alipay transfer mode
  qrPayload    String? // Decoded QR content / payment payload for direct app handoff
  directPayUrl String? // Optional explicit URL scheme or deep link
  directPayMode String? // alipay_to_account / alipay_qr / wechat_qr / image_fallback
  status       String // active / inactive
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String?
  device       Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  orders       Order[]
  rechargeOrders RechargeOrder[]
}

model Device {
  id                     String        @id @default(uuid())
  deviceCode             String        @unique
  deviceSecret           String        @default("")
  name                   String
  bindingExpiresAt       DateTime?
  boundAt                DateTime?
  online                 Boolean       @default(true)
  lastHeartbeat          DateTime?
  androidVersion         String?
  appVersion             String?
  wechatListener         String?       @default("stopped")
  alipayListener         String?       @default("stopped")
  notificationPermission Boolean       @default(false)
  batteryOptimization    String?       @default("unknown")
  status                 String        @default("active") // active / inactive
  userId                 String
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  paymentCodes           PaymentCode[]
  events                 PaymentEvent[]
}

model Order {
  id            String        @id
  outOrderNo    String
  title         String
  payType       String // wechat / alipay
  amount        Float
  realAmount    Float
  amountCents   Int           @default(0)
  realAmountCents Int         @default(0)
  status        String // pending / success / expired / failed / manual_review
  confirmMode   String        @default("auto") // auto / manual
  createdAt     DateTime      @default(now())
  expiresAt     DateTime?
  payTime       DateTime?
  manualConfirmedAt DateTime?
  manualConfirmedBy String?
  manualConfirmNote String?
  returnUrl     String        @default("")
  webhookStatus String        @default("unsent") // unsent / success / failed
  appId         String
  app           App           @relation(fields: [appId], references: [id], onDelete: Cascade)
  paymentCodeId String?
  paymentCode   PaymentCode?  @relation(fields: [paymentCodeId], references: [id], onDelete: SetNull)
  providerPayments ProviderPayment[]
  webhookLogs   WebhookLog[]

  @@unique([appId, outOrderNo])
  @@index([paymentCodeId, status, realAmountCents, expiresAt])
}

model PaymentEvent {
  id               String   @id @default(uuid())
  deviceId         String?
  device           Device?  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sourceType       String   @default("android_device")
  sourceId         String?
  payType          String // wechat / alipay
  amount           Float
  receivedAt       DateTime
  matchStatus      String // matched / unmatched
  matchedOrderId   String?
  confidence       Int
  notificationHash String   @unique
  dedupeKey        String?
  rawNotification  String?
  createdAt        DateTime @default(now())
}

model PaymentProvider {
  id              String   @id @default(uuid())
  type            String   @default("custom_webhook")
  name            String
  status          String   @default("active") // active / inactive
  channels        String   // comma-separated: wechat,alipay
  webhookSecret   String
  secretPreview   String
  configJson      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerPayments ProviderPayment[]

  @@index([userId, status])
}

model ProviderPayment {
  id              String   @id @default(uuid())
  providerId      String
  provider        PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  providerTradeNo String
  outOrderNo      String
  payType         String
  amountCents     Int
  status          String   @default("success")
  rawPayload      String?
  createdAt       DateTime @default(now())

  @@unique([providerId, providerTradeNo])
  @@index([orderId])
}

model WebhookLog {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url             String
  requestTime     DateTime @default(now())
  statusCode      Int?
  responseSummary String?
  responseBody    String?
  retryCount      Int      @default(0)
  result          String // success / failed
  requestBody     String
}

model ExceptionItem {
  id          String   @id @default(uuid())
  type        String // payment_unmatched / expired_payment / webhook_failed / device_offline
  title       String
  description String
  createdAt   DateTime @default(now())
  refId       String
  status      String   @default("active") // active / resolved
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BillingRecord {
  id          String   @id @default(uuid())
  type        String // charge / fee
  amount      Float
  balance     Float
  description String
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RechargeOrder {
  id            String   @id
  amount        Float
  realAmount    Float
  amountCents   Int
  realAmountCents Int
  payType       String // wechat / alipay
  status        String   @default("pending") // pending / success / expired / failed
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  payTime       DateTime?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentCodeId String?
  paymentCode   PaymentCode? @relation(fields: [paymentCodeId], references: [id], onDelete: SetNull)
  confirmMode   String   @default("auto") // auto / manual
}

model ReferralReward {
  id                String    @id @default(uuid())
  rechargeOrderId   String
  invitedUserId     String
  beneficiaryUserId String
  beneficiary       User      @relation(fields: [beneficiaryUserId], references: [id], onDelete: Cascade)
  depth             Int
  tier              String
  rateBps           Int
  baseAmountCents   Int
  rewardCents       Int
  status            String    @default("pending") // pending / credited / void
  createdAt         DateTime  @default(now())
  creditedAt        DateTime?

  @@unique([rechargeOrderId, beneficiaryUserId, depth])
  @@index([beneficiaryUserId, createdAt])
  @@index([invitedUserId])
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminEmail  String
  action      String
  targetType  String
  targetId    String
  beforeJson  String?
  afterJson   String?
  reason      String?
  createdAt   DateTime @default(now())
}

model SystemNotice {
  id          String   @id
  title       String
  content     String
  level       String   @default("info")
  enabled     Boolean  @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, startsAt, endsAt])
}
