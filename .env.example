# Coder Pay Environment Configurations

# APP_URL: The public URL where this web/console application is hosted.
NEXT_PUBLIC_APP_URL="https://3api.shop"

# SESSION_SECRET: HMAC secret used to sign login cookies. Use at least 32 random characters.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# NEXT_PUBLIC_ENABLE_SANDBOX: Enable sandbox testing simulator (only set to true in dev/staging environments).
NEXT_PUBLIC_ENABLE_SANDBOX="false"

# Production email delivery for password reset.
EMAIL_PROVIDER="brevo"
BREVO_API_KEY="xkeysib-xxxxxxxxx"
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="CoderPay <noreply@3api.shop>"

# Platform account used to receive real developer balance recharges.
# Upload platform payment codes and bind platform Watcher devices under this user.
PLATFORM_RECHARGE_USER_EMAIL="yudeyou0118@gmail.com"

# Comma-separated emails allowed to access /admin and /api/admin/*
ADMIN_EMAILS=
